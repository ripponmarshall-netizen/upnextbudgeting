{
  "id": "/",
  "name": "UpNextBudgeting",
  "short_name": "UpNext",
  "description": "A payday-to-payday budget for bills, spending, and what is safe to spend.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#0b0c0e",
  "theme_color": "#0b0c0e",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "lang": "en-JM",
  "dir": "ltr",
  "icons": [
    {
      "src": "assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Add expense",
      "description": "Log a new expense.",
      "url": "./?add=expense",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Budget",
      "short_name": "Budget",
      "description": "Planned vs. actual by category.",
      "url": "./?tab=budget",
      "icons": [
        {
          "src": "assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bills",
      "short_name": "Bills",
      "description": "Upcoming and overdue bills.",
      "url": "./?tab=bills",
      "icons": [
        {
          "src": "assets/icon-192.png",
